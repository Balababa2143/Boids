{
    "compilerOptions": {
        "strict": true,
        "alwaysStrict": true,
        "strictBindCallApply": true,
        "noImplicitAny": false,
        "noFallthroughCasesInSwitch": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": "./src",
        "declaration": true,
        "declarationDir": "./Generated/@type/boids",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "checkJs": true,
        "jsx": "react",
        "inlineSourceMap": true,
        "lib": [
            "DOM",
            "ESNext"
        ],
        "types": [
            "node"
        ],
        "typeRoots": [
            "./node_modules/@types",
            "./kd-structured/Generated/@type"
        ],
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "kd-structured/KinkyDungeon/out/main.d.ts"
    ]
}