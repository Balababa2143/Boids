{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declarationDir": "./.fake/@type-test",
        "declarationMap": false,
        "rootDir": ".",
        "allowImportingTsExtensions": true,
        "types": [
            "node"
        ],
        "typeRoots": [
            "./node_modules/@types",
            "./kd-structured/Generated/@type"
        ]
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts",
        "webpack.config.ts",
        "webpack.test.config.ts",
        "webpack/**/*.ts",
        "kd-structured/KinkyDungeon/out/main.d.ts"
    ]
}
