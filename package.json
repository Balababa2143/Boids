  "scripts": {
    "Webpack Bundle: Debug": "webpack --config webpack.config.ts --mode development",
    "Webpack Watch: Debug": "webpack --config webpack.config.ts --watch --mode development",
    "Webpack Bundle: Production": "webpack --config webpack.config.ts --mode production",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "webpack --config webpack.test.config.ts --mode development && node .fake/test/run.mjs",
    "test:build": "webpack --config webpack.test.config.ts --mode development",
    "test:watch": "webpack --config webpack.test.config.ts --watch --mode development",
    "verify": "npm run typecheck && npm run test",
    "verify:full": "npm run verify && npm run \"Webpack Bundle: Debug\""
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
